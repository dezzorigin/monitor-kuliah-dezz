# Salin ke .env (JANGAN commit .env). Semua nilai di sini hanya contoh jalur.
# Sandi TIDAK PERNAH ditulis di sini — sandi hanya di vault Fernet server.

# Folder data operasi (jadwal.json, absen_state.json, state.json, evidence/).
# Default: /opt/data/monitor-kuliah. Untuk contoh repo: data/
MONITOR_KULIAH_DATA_DIR=/opt/data/monitor-kuliah

# Vault Fernet (kunci + blob terenkripsi) — jalur file, BUKAN isinya.
MONITOR_KULIAH_VAULT_KEY=/opt/data/vault/vault.key
MONITOR_KULIAH_VAULT_ENC=/opt/data/vault/vault.json.enc
